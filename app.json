{
  "expo": {
    "name": "InstaSalud",
    "slug": "instasalud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "instasalud",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4338CA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.instasalud.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesario para escanear documentos médicos",
        "NSPhotoLibraryUsageDescription": "Necesario para seleccionar documentos",
        "NSFaceIDUsageDescription": "Necesario para autenticación biométrica segura",
        "NSLocalNetworkUsageDescription": "Para sincronización de datos médicos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4338CA"
      },
      "package": "com.instasalud.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesario para escanear documentos médicos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesario para seleccionar documentos médicos"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4338CA",
          "sounds": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para acceder de forma segura a tus datos médicos"
        }
      ],
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
